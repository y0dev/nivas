block content
    .mx-4.min-h-screen.max-w-screen-xl(class='sm:mx-8 xl:mx-auto')
      h1.border-b.py-6.text-4xl.font-semibold Settings
      .grid.grid-cols-8.pt-3(class='sm:grid-cols-10')
        .relative.my-4.w-56(class='sm:hidden')
          input#select-1.peer.hidden(type='checkbox', name='select-1')
          label.flex.w-full.cursor-pointer.select-none.rounded-lg.border.p-2.px-3.text-sm.text-gray-700.ring-blue-700(for='select-1', class='peer-checked:ring') Accounts 
          svg.pointer-events-none.absolute.right-0.top-3.ml-auto.mr-5.h-4.text-slate-700.transition(xmlns='http://www.w3.org/2000/svg', class='peer-checked:rotate-180', fill='none', viewBox='0 0 24 24', stroke='currentColor', stroke-width='2')
            path(stroke-linecap='round', stroke-linejoin='round', d='M19 9l-7 7-7-7')
          ul.max-h-0.select-none.flex-col.overflow-hidden.rounded-b-lg.shadow-md.transition-all.duration-300(class='peer-checked:max-h-56 peer-checked:py-3')
            li.cursor-pointer.px-3.py-2.text-sm.text-slate-600(class='hover:bg-blue-700 hover:text-white') Accounts
            li.cursor-pointer.px-3.py-2.text-sm.text-slate-600(class='hover:bg-blue-700 hover:text-white') Team
            li.cursor-pointer.px-3.py-2.text-sm.text-slate-600(class='hover:bg-blue-700 hover:text-white') Others
        .col-span-2.hidden(class='sm:block')
          ul
            li.mt-5.cursor-pointer.border-l-2.border-transparent.px-2.py-2.font-semibold.transition(class='hover:border-l-blue-700 hover:text-blue-700') Teams
            li.mt-5.cursor-pointer.border-l-2.border-l-blue-700.px-2.py-2.font-semibold.text-blue-700.transition(class='hover:border-l-blue-700 hover:text-blue-700') Accounts
            li.mt-5.cursor-pointer.border-l-2.border-transparent.px-2.py-2.font-semibold.transition(class='hover:border-l-blue-700 hover:text-blue-700') Users
            li.mt-5.cursor-pointer.border-l-2.border-transparent.px-2.py-2.font-semibold.transition(class='hover:border-l-blue-700 hover:text-blue-700') Profile
            li.mt-5.cursor-pointer.border-l-2.border-transparent.px-2.py-2.font-semibold.transition(class='hover:border-l-blue-700 hover:text-blue-700') Billing
            li.mt-5.cursor-pointer.border-l-2.border-transparent.px-2.py-2.font-semibold.transition(class='hover:border-l-blue-700 hover:text-blue-700') Notifications
            li.mt-5.cursor-pointer.border-l-2.border-transparent.px-2.py-2.font-semibold.transition(class='hover:border-l-blue-700 hover:text-blue-700') Integrations
        .col-span-8.overflow-hidden.rounded-xl(class='sm:bg-gray-50 sm:px-8 sm:shadow')
          .pt-4
            h1.py-2.text-2xl.font-semibold Account settings
            // <p class="font- text-slate-600">Lorem ipsum dolor, sit amet consectetur adipisicing elit.</p>
          hr.mt-4.mb-8
          p.py-2.text-xl.font-semibold Email Address
          .flex.flex-col(class='sm:flex-row sm:items-center sm:justify-between')
            p.text-gray-600
              | Your email address is 
              strong john.doe@company.com
            button.inline-flex.text-sm.font-semibold.text-blue-600.underline.decoration-2 Change
          hr.mt-4.mb-8
          p.py-2.text-xl.font-semibold Password
          .flex.items-center
            .flex.flex-col.space-y-2(class='sm:flex-row sm:space-y-0 sm:space-x-3')
              label(for='login-password')
                span.text-sm.text-gray-500 Current Password
                .relative.flex.overflow-hidden.rounded-md.border-2.transition(class='focus-within:border-blue-600')
                  input#login-password.w-full.flex-shrink.appearance-none.border-gray-300.bg-white.py-2.px-4.text-base.text-gray-700.placeholder-gray-400(type='password', class='focus:outline-none', placeholder='***********')
              label(for='login-password')
                span.text-sm.text-gray-500 New Password
                .relative.flex.overflow-hidden.rounded-md.border-2.transition(class='focus-within:border-blue-600')
                  input#login-password.w-full.flex-shrink.appearance-none.border-gray-300.bg-white.py-2.px-4.text-base.text-gray-700.placeholder-gray-400(type='password', class='focus:outline-none', placeholder='***********')
            svg.mt-5.ml-2.h-6.w-6.cursor-pointer.text-sm.font-semibold.text-gray-600.underline.decoration-2(xmlns='http://www.w3.org/2000/svg', fill='none', viewBox='0 0 24 24', stroke='currentColor', stroke-width='2')
              path(stroke-linecap='round', stroke-linejoin='round', d='M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21')
          p.mt-2
            | Can&apos;t remember your current password. 
            a.text-sm.font-semibold.text-blue-600.underline.decoration-2(href='#') Recover Account
          button.mt-4.rounded-lg.bg-blue-600.px-4.py-2.text-white Save Password
          hr.mt-4.mb-8
          .mb-10
            p.py-2.text-xl.font-semibold Delete Account
            p.inline-flex.items-center.rounded-full.bg-rose-100.px-4.py-1.text-rose-600
              svg.mr-2.h-5.w-5(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 20 20', fill='currentColor')
                path(fill-rule='evenodd', d='M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z', clip-rule='evenodd')
                      Proceed with caution
            p.mt-2
              | Make sure you have taken backup of your account in case you ever need to get access to your data. We will completely wipe your data. There is no way to access your account after this action.
            button.ml-auto.text-sm.font-semibold.text-rose-600.underline.decoration-2 Continue with deletion