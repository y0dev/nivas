extends ../base

block content
  section.py-32(class='sm:pt-40 md:pt-48 lg:pt-56')
    .mx-auto.px-4(class='sm:px-12 xl:max-w-5xl xl:px-0')
      .relative.z-10.text-center(class='md:mx-auto md:w-5/6 lg:w-4/6')
        h1.relative.text-center.text-4xl.font-bold.text-gray-900(class='dark:text-white sm:text-5xl md:text-6xl')
          | Great to have you 
          span.opacity-80 back!
        p.mt-6.text-gray-700(class='dark:text-gray-300') 
          | We are excited to be able to continue to help you with your investment decisions. If you are new to the site, join our community of real estate investors.
      .mt-12.grid.gap-12(class='sm:mx-auto sm:max-w-lg lg:max-w-full lg:grid-cols-2')
        .relative.rounded-3xl.border.border-gray-100.bg-white.p-8.shadow-2xl(class='shadow-gray-600/10 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none sm:p-12')
          .absolute.inset-0.hidden.scale-105.rounded-3xl.bg-gradient-to-b.from-transparent(class='dark:block dark:to-gray-900/80')
          .relative
            h2.text-2xl.font-bold.text-gray-800(class='dark:text-white') Login
          .text-sm.font-md.mt-2.text-gray-600(class='dark:text-gray-300')
            | Not registered yet? 
            a.font-medium.ml-auto.text-primary(class='hover:underline dark:text-primaryLight' href='/signup') Create an Account
          form.form-magic--login.relative(action='' class='')
            .mt-8.mb-6.space-y-4
              div.form__group
                label.mb-2.block.text-gray-600(for="email" class='dark:text-gray-300')
                  | Email
                  span.text-xl.text-red-500(class='dark:text-red-400') *
                input#email.peer.block.w-full.rounded-lg.border.border-gray-200.bg-transparent.px-4.py-2.text-gray-600.transition-shadow.duration-300(type='email' name='email' autocomplete='email' class='focus:ring-2 dark:border-gray-700')
            button#magic-link-btn.relative.m-auto.flex.w-full.h-11.items-center.justify-center.px-6(type='submit' class='before:absolute before:inset-0 before:rounded-full before:bg-primary before:transition-transform before:duration-300 active:duration-75 active:before:scale-95 dark:before:bg-primaryLight')
              span.relative.text-base.font-semibold.text-white(class='dark:text-gray-900') Send me a magic link
          .flex.flex-col.items-center.px-8.py-4.text-center.text-sm.text-gray-800(class='dark:text-white')
            a.underline.underline-offset-4(class='hover:text-brand', data-state='closed', href='/login/password') Log in using password
          .relative.py-2
            div.absolute.inset-0.flex.items-center
              span.w-full.border-t
            div.relative.flex.justify-center.pb-2.text-xs.uppercase
              span.bg-white.px-2.text-gray-800(class='dark:text-white dark:bg-gray-800') Or continue with
          .flex.flex-col.gap-2.text-gray-800(class='dark:text-white')
            button.inline-flex.items-center.justify-center.rounded-md.text-sm.font-medium.ring-offset-background.transition-colors.border.border-input.bg-background.h-10.px-4.py-2(type='button', class='focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground', data-state='closed')
              svg.mr-2.h-4.w-4(width='48px', height='48px', viewBox='0 0 48 48', enable-background='new 0 0 48 48')
                path(fill='#FFC107', d='M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12 c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24 c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z')
                path(fill='#FF3D00', d='M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657 C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z')
                path(fill='#4CAF50', d='M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36 c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z')
                path(fill='#1976D2', d='M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571 c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z')
              |  Sign in with Google
            button.inline-flex.items-center.justify-center.rounded-md.text-sm.font-medium.ring-offset-background.transition-colors.border.border-input.bg-background.h-10.px-4.py-2(class='focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground', data-state='closed')
              svg.mr-2.h-4.w-4(aria-hidden='true', focusable='false', data-prefix='fab', data-icon='github', role='img', xmlns='http://www.w3.org/2000/svg', viewBox='0 0 496 512')
                path(fill='currentColor', d='M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3 .3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5 .3-6.2 2.3zm44.2-1.7c-2.9 .7-4.9 2.6-4.6 4.9 .3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3 .7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3 .3 2.9 2.3 3.9 1.6 1 3.6 .7 4.3-.7 .7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3 .7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3 .7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z')
              |  Sign in with GitHub
          p.py-4.text-xs.text-center.text-gray-800(class='dark:text-white')
            | New accounts are subject to Urban Insight&apos;s 
            br
            a.underline(class='hover:no-underline', target='_blank', href='/terms-of-service/') Terms of Service
            |  and 
            a.underline(class='hover:no-underline', target='_blank', href='/privacy-policy/') Privacy Policy
            | .
        div
          .relative.rounded-3xl.border.border-gray-100.bg-white.p-8.shadow-2xl(class='shadow-gray-600/10 dark:border-gray-700 dark:bg-gray-800 dark:shadow-none lg:px-12')
            .absolute.inset-0.hidden.scale-105.rounded-3xl.bg-gradient-to-b.from-transparent(class='dark:block dark:to-gray-900/80')
            .relative
              //- img.h-12.w-auto(class='dark:contrast-100 dark:grayscale dark:invert' src='./../images/clients/microsoft.svg' alt='microsoft' width='' height='')
              p.mt-2.mb-8.text-gray-600(class='dark:text-gray-300')
                | Success is liking yourself, liking what you do, and liking how you do it.
              .flex.gap-4
                //- img.h-12.w-12.rounded-full(src='./../images/avatars/avatar-2.webp' alt='user avatar' width='200' height='200' loading='lazy')
                div
                  h2.leading-0.text-lg.font-medium.text-gray-700(class='dark:text-white') Maya Angelou
